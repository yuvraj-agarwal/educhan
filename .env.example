# Copy to .env and adjust as needed. The defaults match the local PostgreSQL
# cluster provisioned by .cursor/scripts/start.sh.
DATABASE_URL=postgres://educhan:educhan@localhost:5432/educhan?sslmode=disable
EDUCHAN_ADDR=:8080

# Keys per-thread poster IDs and secure tripcodes. A random value is generated
# when unset, which means both change on every restart.
EDUCHAN_POSTER_ID_SALT=

# Read the client address from X-Forwarded-For. Only enable this behind a proxy
# that overwrites the header, otherwise it is trivially spoofable.
EDUCHAN_TRUST_PROXY=false

# Flood control: minimum interval between two new threads and two replies from
# the same client. Bare numbers are seconds; 0 disables the check.
EDUCHAN_THREAD_COOLDOWN=15
EDUCHAN_POST_COOLDOWN=3

# text or json
EDUCHAN_LOG_FORMAT=text

# Where uploaded originals and thumbnails are written.
EDUCHAN_UPLOAD_DIR=./data/uploads
# Largest accepted attachment, in bytes (default 8 MiB).
EDUCHAN_MAX_UPLOAD_BYTES=8388608
