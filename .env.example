# Copy to .env and adjust as needed. The defaults match the local PostgreSQL
# cluster provisioned by .cursor/scripts/start.sh.
DATABASE_URL=postgres://educhan:educhan@localhost:5432/educhan?sslmode=disable

# Listen address. Leave it unset on Cloud Run and anywhere else that injects a
# port in PORT: that is used when this is empty, and setting it wins over PORT.
EDUCHAN_ADDR=:8080

# Keys per-thread poster IDs and secure tripcodes. A random value is generated
# when unset, which means both change on every restart.
EDUCHAN_POSTER_ID_SALT=

# How many reverse proxies stand in front of this server, each appending the
# address it saw to X-Forwarded-For. 0 (or false) ignores the header and uses
# the peer address, which is correct when the server is exposed directly.
# 1 (or true) is the usual single load balancer; count every hop that appends.
# Setting this higher than the real chain lets clients forge their own address.
EDUCHAN_TRUST_PROXY=0

# Flood control: minimum interval between two new threads, two replies, and two
# attachments from the same client. Thread and post cooldowns are per board;
# the upload cooldown is server-wide. Bare numbers are seconds; 0 disables one.
EDUCHAN_THREAD_COOLDOWN=30
EDUCHAN_POST_COOLDOWN=5
EDUCHAN_UPLOAD_COOLDOWN=15

# text or json
EDUCHAN_LOG_FORMAT=text

# Shared secret for the moderation endpoints and for board management, sent as
# "Authorization: Bearer <key>" or "X-Mod-Key: <key>". Leaving it empty keeps
# both switched off.
EDUCHAN_MOD_KEY=

# Institutional verification ("Verified Anonymity"). Leaving the secret empty
# switches the whole feature off: there is nothing to sign a credential with.
# It keys the address hash, the pending code hash, and the credential
# signature, so rotating it revokes every badge and everyone verifies again.
EDUCHAN_VERIFY_SECRET=

# How long an emailed code stays usable, and how long a badge lasts before the
# holder has to verify again. Bare numbers are seconds.
EDUCHAN_VERIFY_CODE_TTL=15m
EDUCHAN_VERIFY_CREDENTIAL_TTL=4320h

# Minimum interval between two code requests, applied per client address and
# per address hash.
EDUCHAN_VERIFY_COOLDOWN=60

# An allowlist file replacing the one embedded in the binary
# (internal/app/verify_domains.txt). It replaces rather than extends it.
EDUCHAN_VERIFY_DOMAINS=

# The captcha: a proof-of-work puzzle the browser solves before an unbadged
# post or a code request goes out, issued and checked by this server alone.
# Leaving the secret empty switches it off. Set it to at least 32 characters
# (openssl rand -hex 32), the same on every instance. Rotating it only
# invalidates the challenges out at the time.
EDUCHAN_CAPTCHA_SECRET=

# Average number of PBKDF2 attempts a challenge asks for, before an address
# asking for challenges fast is given harder ones. 1 to 10000; above a few
# thousand, a slow phone waits a long while before every post.
EDUCHAN_CAPTCHA_WORK=1500

# Where attachments are stored: "local" (the default) or "gcs".
EDUCHAN_MEDIA_BACKEND=local

# local backend: where uploaded originals and thumbnails are written. The
# container image defaults this to /data/uploads. Unused when the backend is
# "gcs".
EDUCHAN_UPLOAD_DIR=./data/uploads

# gcs backend: the bucket to store objects in, and an optional key prefix within
# it. The bucket is required when EDUCHAN_MEDIA_BACKEND=gcs and ignored
# otherwise. Credentials come from Application Default Credentials — the
# attached service account on Cloud Run, or GOOGLE_APPLICATION_CREDENTIALS
# pointing at a key file locally — so there is nothing to put here. Use this on
# Cloud Run: the container filesystem does not outlive the container. See
# deploy/README.md.
# EDUCHAN_GCS_BUCKET=educhan-media
# EDUCHAN_GCS_PREFIX=media
# Largest accepted attachment, in bytes (default 8 MiB).
EDUCHAN_MAX_UPLOAD_BYTES=8388608

# Accept image attachments. Off by default: originals are stored as uploaded,
# with no metadata stripping or scanning yet. Turn on locally to test images.
EDUCHAN_UPLOADS_ENABLED=false

# Connection pool cap per instance (default 3). Instances times this must fit
# the database's connection limit; see deploy/README.md section 3.
# EDUCHAN_DB_MAX_CONNS=3

# Allow the development mail sender, which prints verification codes and the
# address they were sent to on stdout. Without it the server refuses to start
# when EDUCHAN_VERIFY_SECRET is set and no real sender exists. Local use only.
# EDUCHAN_MAIL_DEV=1
